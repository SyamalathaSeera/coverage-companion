# Leave credentials empty for the fully local extractive demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional sanitized summary traces only (never document text or questions).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=coverage-companion
# Set both in hosted HTTPS environments.
COOKIE_SECURE=false
APP_ORIGIN=
# Shared allowances for a single-worker deployment. Restart resets counters.
CHAT_REQUESTS_PER_MINUTE=60
UPLOADS_PER_MINUTE=10
OPENAI_DAILY_CALL_LIMIT=100
